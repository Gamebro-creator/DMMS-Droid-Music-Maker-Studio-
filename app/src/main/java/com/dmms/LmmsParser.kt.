package com.dmms.app

data class LmmsNote(
    val pos: Int, 
    val len: Int, 
    val key: Int, 
    val vel: Int  
)

data class LmmsTrack(
    val name: String,
    val instrument: String, 
    val type: String, // NEW: "instrument" or "beat"
    val notes: List<LmmsNote>
)

data class LmmsProject(
    val bpm: Int,
    val tracks: List<LmmsTrack>
)

object LmmsParser {
    fun loadTestProject(): LmmsProject {
        // Melody for the Piano Roll
        val synthNotes = listOf(
            LmmsNote(pos = 0, len = 48, key = 60, vel = 100),   
            LmmsNote(pos = 48, len = 48, key = 64, vel = 100),  
            LmmsNote(pos = 96, len = 48, key = 67, vel = 100),  
            LmmsNote(pos = 144, len = 96, key = 72, vel = 100)  
        )
        
        // Drum pattern for the Beat/Bassline (16 steps = 1 bar)
        val kickNotes = listOf(
            LmmsNote(pos = 0, len = 1, key = 0, vel = 100),
            LmmsNote(pos = 4, len = 1, key = 0, vel = 100),
            LmmsNote(pos = 8, len = 1, key = 0, vel = 100),
            LmmsNote(pos = 12, len = 1, key = 0, vel = 100)
        )
        
        val hatNotes = listOf(
            LmmsNote(pos = 2, len = 1, key = 0, vel = 100),
            LmmsNote(pos = 6, len = 1, key = 0, vel = 100),
            LmmsNote(pos = 10, len = 1, key = 0, vel = 100),
            LmmsNote(pos = 14, len = 1, key = 0, vel = 100)
        )

        return LmmsProject(
            bpm = 140,
            tracks = listOf(
                LmmsTrack(name = "TripleOscillator", instrument = "tripleoscillator", type = "instrument", notes = synthNotes),
                LmmsTrack(name = "Kicker", instrument = "kicker", type = "beat", notes = kickNotes),
                LmmsTrack(name = "Hi-Hat", instrument = "sample", type = "beat", notes = hatNotes)
            )
        )
    }
}