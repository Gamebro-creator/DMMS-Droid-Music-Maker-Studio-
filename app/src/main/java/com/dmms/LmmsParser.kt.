Ipackage com.dmms.app

// 1. This matches LMMS <note> tag
data class LmmsNote(
    val pos: Int, // Start time in ticks (192 ticks = 1 bar)
    val len: Int, // Length in ticks
    val key: Int, // MIDI pitch (0-127, 60 is Middle C)
    val vel: Int  // Velocity (0-100)
)

// 2. This matches an LMMS Track
data class LmmsTrack(
    val name: String,
    val instrument: String, // e.g., "tripleoscillator"
    val notes: List<LmmsNote>
)

// 3. This matches the whole LMMS Project
data class LmmsProject(
    val bpm: Int,
    val tracks: List<LmmsTrack>
)

object LmmsParser {
    // This is a fake LMMS file to test our app! 
    // It has a melody and a bassline.
    fun loadTestProject(): LmmsProject {
        val synthNotes = listOf(
            LmmsNote(pos = 0, len = 48, key = 60, vel = 100),   // C4
            LmmsNote(pos = 48, len = 48, key = 64, vel = 100),  // E4
            LmmsNote(pos = 96, len = 48, key = 67, vel = 100),  // G4
            LmmsNote(pos = 144, len = 96, key = 72, vel = 100)  // C5
        )
        
        val bassNotes = listOf(
            LmmsNote(pos = 0, len = 96, key = 36, vel = 100),   // C2
            LmmsNote(pos = 96, len = 96, key = 43, vel = 100)   // G2
        )

        return LmmsProject(
            bpm = 140,
            tracks = listOf(
                LmmsTrack(name = "TripleOscillator", instrument = "tripleoscillator", notes = synthNotes),
                LmmsTrack(name = "Kicker", instrument = "kicker", notes = bassNotes)
            )
        )
    }
}